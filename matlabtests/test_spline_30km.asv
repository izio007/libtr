TRAJECTORY_POINTS_COUNT = 1000;
TARGET_X_START  = -15000;
TARGET_X_FINISH =  15000;
TARGET_Y_STATIC =  30000; 
TARGET_Z_STATIC =  0;

% Координаты 4 измерительных пунктов с учетом размаха сплайна 5 км (в метрах)
% Амплитуда колебаний по оси Y составляет строго от 20.0 до 25.0 км
STATION_X = [0, -5000, 5000, 625*4];
STATION_Y = [0, 10000, 20000, 25000];
STATION_Z = [    1000,     1000,     1000,     1000];

DOA_ERROR_DEGREE = 0.4;
RANDOM_SEED = 1337;

t_param = 1:length(STATION_X_ANCHORS);
t_dense = linspace(1, length(STATION_X_ANCHORS), 1000);
fine_spline_x = spline(t_param, STATION_X_ANCHORS, t_dense);
fine_spline_y = spline(t_param, STATION_Y_ANCHORS, t_dense);
fine_spline_z = spline(t_param, STATION_Z_ANCHORS, t_dense);

t_steps = linspace(0, 1, TRAJECTORY_POINTS_COUNT);
x_true = TARGET_X_START + (TARGET_X_FINISH - TARGET_X_START) * t_steps;
y_true = TARGET_Y_STATIC * ones(size(t_steps));
z_true = TARGET_Z_STATIC * ones(size(t_steps));

station_counts_to_test =64;
results_rmse = zeros(length(station_counts_to_test), 1);
results_bias_y = zeros(length(station_counts_to_test), 1);

for s_idx = 1:length(station_counts_to_test)
    N_stations = station_counts_to_test(s_idx);
    
    idx_select = round(linspace(1, length(t_dense), N_stations));
    STATION_POSITIONS = [fine_spline_x(idx_select); fine_spline_y(idx_select); fine_spline_z(idx_select)];
    
    VAR_ALPHA = deg2rad(DOA_ERROR_DEGREE)^2 * ones(N_stations, 1);
    VAR_BETA  = deg2rad(DOA_ERROR_DEGREE)^2 * ones(N_stations, 1);
    
    results_pos = zeros(3, TRAJECTORY_POINTS_COUNT);
    status_position = zeros(1, TRAJECTORY_POINTS_COUNT);
    
    rng(RANDOM_SEED);
    
    for k = 1:TRAJECTORY_POINTS_COUNT
        target_true = [x_true(k); y_true(k); z_true(k)];
        alpha_measured = zeros(N_stations, 1);
        beta_measured  = zeros(N_stations, 1);
        
        for i = 1:N_stations
            dx = target_true(1) - STATION_POSITIONS(1, i);
            dy = target_true(2) - STATION_POSITIONS(2, i);
            dz = target_true(3) - STATION_POSITIONS(3, i);
            r_xy = sqrt(dx^2 + dy^2);
            
            alpha_measured(i) = atan2(dy, dx) + deg2rad(DOA_ERROR_DEGREE) * randn();
            beta_measured(i)  = atan2(dz, r_xy) + deg2rad(DOA_ERROR_DEGREE) * randn();
        end
        
        [st_p, lambda] = lls3d_position(STATION_POSITIONS, alpha_measured, beta_measured);
        status_position(k) = st_p;
        if st_p == 0
            results_pos(:, k) = lambda;
        end
    end
    
    valid_mask = (status_position == 0);
    error_x = results_pos(1, valid_mask) - x_true(valid_mask);
    error_y = results_pos(2, valid_mask) - y_true(valid_mask);
    error_z = results_pos(3, valid_mask) - z_true(valid_mask);
    
    results_rmse(s_idx) = sqrt(mean(error_x.^2 + error_y.^2 + error_z.^2));
    results_bias_y(s_idx) = mean(error_y);
end

figure;
subplot(2,1,1);
plot(station_counts_to_test, results_rmse / 1000, 'r-o', 'LineWidth', 2);
grid on;
xlabel('Number of Stations along Spline'); ylabel('Total Spatial RMSE, km');
title('Miss Control vs Station Density');

subplot(2,1,2);
plot(station_counts_to_test, abs(results_bias_y) / 1000, 'b-s', 'LineWidth', 2);
grid on;
xlabel('Number of Stations along Spline'); ylabel('Absolute Range Bias (Y), km');

for s_idx = 1:length(station_counts_to_test)
    fprintf('Станций: %2d | Промах RMSE: %6.2f м | Смещение Bias Y: %6.2f м\n', ...
        station_counts_to_test(s_idx), results_rmse(s_idx), results_bias_y(s_idx));
end
