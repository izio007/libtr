#!/bin/bash

# Цвета для вывода в консоль
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${GREEN}=========================================================================${NC}"
echo -e "${GREEN}          ЗАПУСК КОМПЛЕКСНОЙ ДИАГНОСТИКИ ЦЕНТРА РАЗРАБОТКИ               ${NC}"
echo -e "${GREEN}=========================================================================${NC}"

# 1. ПРОВЕРКА ВЕРСИЙ ПО И ОКРУЖЕНИЯ
echo -e "\n[1/6] Проверка установленных версий программ:"
for cmd in git pytest gitlab-runner docker nvidia-smi ollama; do
    if command -v $cmd &> /dev/null; then
        echo -e "  $cmd: ${GREEN}Установлен${NC} ($( $cmd --version 2>&1 | head -n 1 ))"
    else
        echo -e "  $cmd: ${RED}НЕ НАЙДЕН${NC}"
    fi
done

# 2. ПРОВЕРКА СТАТУСА GPU NVIDIA
echo -e "\n[2/6] Проверка видеокарты NVIDIA:"
if command -v nvidia-smi &> /dev/null; then
    nvidia-smi --query-gpu=name,driver_version,memory.total,temperature.gpu --format=csv,noheader 2>&1 | while read line; do
        echo -e "  GPU: ${GREEN}$line${NC}"
    done
else
    echo -e "  ${RED}Драйвер NVIDIA не активен или не установлен.${NC}"
fi

# 3. СТАТУС СИСТЕМНЫХ СЛУЖБ (SYSTEMD)
echo -e "\n[3/6] Проверка активности фоновых служб:"
for service in ollama gitlab-runner docker gitlab-runsvdir; do
    if systemctl is-active --quiet $service; then
        echo -e "  Служба $service: ${GREEN}Работает (active)${NC}"
    else
        echo -e "  Служба $service: ${RED}ОСТАНОВЛЕНА (inactive)${NC}"
    fi
done

# 4. СПИСОК ЛОКАЛЬНЫХ ИИ-МОДЕЛЕЙ
echo -e "\n[4/6] Загруженные модели в Ollama:"
if systemctl is-active --quiet ollama; then
    models=$(ollama list | tail -n +2)
    if [ -z "$models" ]; then
        echo -e "  ${RED}Модели не найдены. Список пуст.${NC}"
    else
        echo "$models" | while read -r name id size modified; do
            echo -e "  Модель: ${GREEN}$name${NC} (Размер: $size)"
        done
    fi
else
    echo -e "  ${RED}Невозможно получить список моделей, так как служба Ollama выключена.${NC}"
fi

# 5. ТЕСТИРОВАНИЕ СРЕДЫ PYTEST (СОЗДАНИЕ И ЗАПУСК ТЕСТА)
echo -e "\n[5/6] Проверка работы Pytest:"
mkdir -p /tmp/pytest_diag
cat << 'EOF' > /tmp/pytest_diag/test_sample.py
def test_environment_is_ok():
    assert 1 + 1 == 2
EOF
if pytest /tmp/pytest_diag/test_sample.py &> /dev/null; then
    echo -e "  Запуск pytest: ${GREEN}УСПЕШНО (Тесты проходят)${NC}"
else
    echo -e "  Запуск pytest: ${RED}ОШИБКА РАБОТЫ${NC}"
fi
rm -rf /tmp/pytest_diag

# 6. ТЕСТОВЫЙ ЗАПРОС К DEEPSEEK ЧЕРЕЗ LOCALHOST API
echo -e "\n[6/6] Проверка генерации DeepSeek (API запрос на порт 11434):"
if systemctl is-active --quiet ollama; then
    # Определяем, какая модель доступна (берем первую из списка)
    target_model=$(ollama list | tail -n +2 | awk '{print $1}' | head -n 1)
    
    if [ -z "$target_model" ]; then
        echo -e "  ${RED}Проверка API отменена: нет доступных моделей для теста.${NC}"
    else
        echo -e "  Отправка экспресс-запроса в модель [${GREEN}$target_model${NC}]..."
        
        # Делаем локальный curl запрос к Ollama API
        response=$(curl -s -X POST http://localhost:11434/api/generate -d "{
          \"model\": \"$target_model\",
          \"prompt\": \"Ответь строго одним словом ОК\",
          \"stream\": false
        }")
        
        # Извлекаем ответ из JSON структуры
        ai_output=$(echo "$response" | grep -o '"response":"[^"]*' | grep -o '[^"]*$')
        
        if [ ! -z "$ai_output" ]; then
            echo -e "  Ответ от ИИ получен: ${GREEN}${ai_output}${NC}"
        else
            echo -e "  ${RED}API ответил пустой строкой или вернул ошибку.${NC}"
        fi
    fi
else
    echo -e "  ${RED}Проверка API невозможна: Ollama выключена.${NC}"
fi

echo -e "\n${GREEN}=========================================================================${NC}"
echo -e "${GREEN}                      ДИАГНОСТИКА ЗАВЕРШЕНА                              ${NC}"
echo -e "${GREEN}=========================================================================${NC}"
