#!/bin/bash
# =========================================================================
# ПОЛНЫЙ СКРИПТ УСТАНОВКИ ЦЕНТРА РАЗРАБОТКИ (Интернет + Флешка)
# =========================================================================

echo "=== 1. Обновление системы и установка базовых утилит ==="
sudo apt update && sudo apt upgrade -y
sudo apt install -y zstd git python3-pip python3-venv docker.io curl openssh-server ca-certificates tzdata perl

# Переходим в папку на флешке, где лежат инсталляторы
cd /mnt/usb/ollama

echo "=== 2. Установка драйверов NVIDIA и CUDA ==="
chmod +x nvidia-driver-550.run cuda-toolkit-12.4.1.run
sudo ./nvidia-driver-550.run --silent --dkms
sudo ./cuda-toolkit-12.4.1.run --silent --toolkit

# Настройка контейнеров для ИИ
curl -fsSL https://github.io | sudo gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
curl -s -L https://github.io | sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' | sudo tee /etc/apt/sources.list.d/nvidia-container-toolkit.list
sudo apt update && sudo apt install nvidia-container-toolkit -y
sudo systemctl restart docker

echo "=== 3. Распаковка Ollama и импорт моделей DeepSeek ==="
sudo tar -C /usr -xzf ollama-linux-amd64.tar.zst

sudo useradd -r -s /bin/false -U -m -d /usr/share/ollama ollama
sudo usermod -a -G ollama ktuser

sudo tee /etc/systemd/system/ollama.service <<EOF
[Unit]
Description=Ollama Service
After=network-online.target

[Service]
ExecStart=/usr/bin/ollama serve
User=ollama
Group=ollama
Restart=always
RestartSec=3
Environment="OLLAMA_HOST=0.0.0.0"

[Install]
WantedBy=default.target
EOF

sudo systemctl daemon-reload
sudo systemctl enable --now ollama

# Импорт моделей из .gguf файлов
echo "FROM ./deepseek-r1-8b.gguf" > Modelfile_8b
ollama create deepseek-r1:8b -f Modelfile_8b

echo "FROM ./deepseek-r1-32b.gguf" > Modelfile_32b
ollama create deepseek-r1:32b -f Modelfile_32b

echo "=== 4. Установка Pytest из интернета ==="
sudo pip3 install pytest

echo "=== 5. Установка локального GitLab и Runner с флешки ==="
sudo dpkg -i gitlab-ce_16.1.1-ce.0_amd64.deb
sudo dpkg -i gitlab-runner_amd64.deb
sudo gitlab-ctl reconfigure

echo "=== Установка завершена! ==="
cd ~
sudo umount /mnt/usb
